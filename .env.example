# ============================================================
#  环境配置模板 —— 复制为 .env 后填入真实值
# ============================================================

# --- 服务基础 ---
PORT=3000
NODE_ENV=development

# --- 微信小程序 ---
WX_APPID=your_appid
WX_SECRET=your_secret

# --- 微信支付 ---
WX_PAY_MCH_ID=your_mch_id
WX_PAY_API_KEY=your_api_key
WX_PAY_NOTIFY_URL=https://yourdomain.com/api/pay/notify

# ============================================================
#  AI 大模型（QWEN / 阿里云百炼 DashScope）
#  👉 申请地址：https://bailian.console.aliyun.com/
#  👉 开通模型：qwen-plus（文本）+ qwen-vl-plus（多模态/OCR）
#  👉 一套 API Key 同时覆盖文本分析和图片 OCR
# ============================================================
AI_PROVIDER=qwen
AI_API_KEY=sk-your-dashscope-api-key-here
AI_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_TEXT_MODEL=qwen-plus
AI_VL_MODEL=qwen-vl-plus
AI_TIMEOUT=60000

# ============================================================
#  说明：
#  • 未配置 AI_API_KEY 时，自动降级为【本地规则引擎演示模式】
#  • OCR 不再需要独立服务，由 qwen-vl-plus 多模态模型直接处理
# ============================================================

# --- 可选：邮件服务（文书发送到用户邮箱）---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password
